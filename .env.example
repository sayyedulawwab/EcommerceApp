# Copy to .env.dev (local) or .env.prod and fill in the values. Never commit the copies.
POSTGRES_DB=ecommercedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# At least 32 characters
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# Optional: defaults to Ecommerce
JWT_ISSUER=Ecommerce
JWT_AUDIENCE=Ecommerce
# Optional: the API image tag, defaults to latest
IMAGE_TAG=latest
