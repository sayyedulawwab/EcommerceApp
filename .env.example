# Copy to .env.dev (local) or .env.prod and fill in the values. Never commit the copies.
POSTGRES_DB=ecommercedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Required, at least 32 bytes. No default: compose and the API refuse to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET_KEY=
# Optional: defaults to Ecommerce
JWT_ISSUER=Ecommerce
JWT_AUDIENCE=Ecommerce
# Optional: the network nginx reaches the API from (the pinned ecommerce-network subnet)
# TRUSTED_PROXY_NETWORK=172.28.0.0/24
# Optional: the API image tag, defaults to latest
IMAGE_TAG=latest
