[Unit]
Description=Deploy the latest published EcommerceApp release
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# A dedicated user whose only extra right is the docker group (see deploy/README.md).
User=ecommerce-deploy
Group=ecommerce-deploy
SupplementaryGroups=docker
# State and docker's client config live in /var/lib/ecommerce-deploy, which systemd creates for the user.
StateDirectory=ecommerce-deploy
Environment=HOME=/var/lib/ecommerce-deploy
Environment=APP_DIR=/opt/ecommerce
Environment=ENV_FILE=/etc/ecommerce/.env.prod
Environment=STATE_DIR=/var/lib/ecommerce-deploy
ExecStart=/opt/ecommerce/deploy/deploy.sh
# A pull, a migration and the health wait fit well inside this.
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
