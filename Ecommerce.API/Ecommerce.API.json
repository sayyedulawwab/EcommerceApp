  "components": {
    "schemas": {
      "AddCategoryRequest": {
        "required": [
          "name",
          "code"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "AddProductRequest": {
        "required": [
          "name",
          "description",
          "priceCurrency",
          "priceAmount",
          "quantity",
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceCurrency": {
            "type": "string"
          },
          "priceAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
